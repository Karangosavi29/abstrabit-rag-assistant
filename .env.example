# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Gemini API key (Google AI Studio -> Get API key, free tier, no card)
GEMINI_API_KEY=your-gemini-api-key

# Slack or Discord incoming webhook URL used by the send_summary tool.
# Slack: https://api.slack.com/messaging/webhooks
# Discord: Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy URL
NOTIFY_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
